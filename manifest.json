{
  "manifest_version": 3,
  "name": "Keep Alive",
  "version": "1.5.0",
  "description": "Mantém sessões web ativas com pedidos periódicos configuráveis por site.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Keep Alive",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
